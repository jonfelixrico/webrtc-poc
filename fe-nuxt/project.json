{
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "fe-nuxt",
  "targets": {
    "dev:deep": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx dev @webrtcpoc/fe-nuxt",
          "nx watch --projects=@webrtcpoc/fe-nuxt --includeDependentProjects -- nx run-many -t build -p \\$NX_PROJECT_NAME --exclude=@webrtcpoc/fe-nuxt"
        ]
      },
      "parallelism": true
    }
  }
}
