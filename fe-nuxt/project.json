{
  "name": "fe-nuxt",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "fe-nuxt",
  "targets": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true
    },

    "dev:deep": {
      "dependsOn": ["^build"],
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "nx dev fe-nuxt",
          "nx watch --projects=fe-nuxt --includeDependentProjects -- nx run-many -t build -p \\$NX_PROJECT_NAME --exclude=fe-nuxt"
        ]
      },
      "parallelism": true
    }
  }
}
